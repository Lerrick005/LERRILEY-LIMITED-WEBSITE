# Lerriley Limited - Environment variable template
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
# NEVER paste real secrets into this file - only example placeholders.
#
# Variables prefixed NEXT_PUBLIC_ are bundled into client code.
# Everything else is server-only.

# --- Public (safe to expose to the browser) ----------------------------

# WhatsApp number in E.164 format WITHOUT the plus sign.
# Example: for +254 114 045 0296, enter: 2541140450296
# Digits only, 10-15 characters.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Production site origin, used for canonical URLs, sitemap, Open Graph.
# Leave blank in development.
NEXT_PUBLIC_SITE_URL=

# --- Server-only (never exposed to the browser) ------------------------
# Add these as features are built. They are not required at launch.
#
# DATABASE_URL=postgresql://user:password@host:5432/database
# RESEND_API_KEY=
# LEAD_NOTIFICATION_TO=
# TURNSTILE_SECRET=
# PLAUSIBLE_DOMAIN=